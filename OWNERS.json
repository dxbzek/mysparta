{
  "about": "One writer per file. Each lane (work package) owns the paths its globs match. tools/check-ownership.mjs fails when a path has no owner or two owners, and when a lane branch (rebuild/v2-<lane>) changes a path it does not own. Globs: ** crosses folders, * stays inside one name, a leading ! takes paths away from that lane. wp0 is the Lead: contracts, fixtures, seam files and repo config. A lane that needs a change in a wp0 file asks for it in its handoff.",
  "lanes": {
    "wp0": [
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig*.json",
      ".gitignore",
      ".gitattributes",
      "README.md",
      "CREDITS.md",
      "OWNERS.json",
      ".github/**",
      ".claude/launch.json",
      "types/**",
      "packages/*/package.json",
      "packages/*/tsconfig*.json",
      "packages/*/vitest.config.ts",
      "apps/*/package.json",
      "apps/*/tsconfig*.json",
      "apps/*/vitest.config.ts",
      "apps/*/vite.config.ts",
      "docs/PROVENANCE.md",
      "packages/core/src/prng.ts",
      "packages/core/src/index.ts",
      "packages/core/src/contracts/**",
      "packages/core/src/fixtures/**",
      "packages/core/test/contracts.test.ts",
      "packages/rig/src/index.ts",
      "packages/rig/src/contracts.ts",
      "packages/rig/src/testing/**",
      "packages/rig/test/testing/**",
      "packages/stage/src/index.ts",
      "packages/stage/src/contracts.ts",
      "packages/stage/test/contracts.test.ts",
      "apps/web/index.html",
      "apps/web/src/main.tsx",
      "apps/web/src/vite-env.d.ts",
      "apps/web/src/contracts.ts",
      "apps/web/src/seams/**",
      "apps/web/test/seams/**",
      "apps/web/public/favicon.svg",
      "tools/check-banned-terms.mjs",
      "tools/banned-terms.allow",
      "tools/check-ownership.mjs",
      "tools/lib/**",
      "tools/smoke-canvas.ts",
      "tools/tsconfig.json",
      "tools/budgets.mjs"
    ],
    "wp1": [
      "packages/core/src/**",
      "!packages/core/src/prng.ts",
      "!packages/core/src/index.ts",
      "!packages/core/src/contracts/**",
      "!packages/core/src/fixtures/**",
      "packages/core/test/**",
      "!packages/core/test/contracts.test.ts",
      "tools/find-bout.ts",
      "tools/balance-report.ts",
      "tools/ladder-report.ts",
